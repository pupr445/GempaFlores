# Salin file ini menjadi .env.local lalu isi dengan nilai asli kamu.
# JANGAN commit file .env.local ke GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-supabase-kamu

# Alamat Cloudflare Worker (lihat /cloudflare-worker dan /PANDUAN-B2.md).
# Foto & video dikirim ke sini, disimpan ke Backblaze B2 lewat Worker —
# bukan ke Supabase Storage lagi. Data laporan tetap di Supabase seperti biasa.
NEXT_PUBLIC_UPLOAD_WORKER_URL=https://gempaflores-storage.namaakunmu.workers.dev

# Catatan: lokasi hanya memakai koordinat GPS perangkat (gratis, bawaan
# browser) — tidak ada API geocoding berbayar yang dipanggil. Kab/kota,
# kecamatan, dan desa/kelurahan dipilih/diketik manual oleh pelapor,
# jadi tidak ada key tambahan yang perlu diisi di sini.
