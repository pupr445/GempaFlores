# Salin file ini jadi ".env" di folder yang sama, lalu isi nilai aslinya.
# JANGAN commit file .env ke GitHub — isinya kredensial rahasia penuh.

# Supabase — pakai SERVICE ROLE key (bukan anon key), diambil dari
# Dashboard Supabase > Project Settings > API > service_role secret.
SUPABASE_URL=https://jqkwaefpwuflyzhznzxq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-supabase-kamu

# Backblaze B2 — sama persis dengan yang diisi lewat `wrangler secret put`
# di folder cloudflare-worker.
B2_REGION=us-west-004
B2_KEY_ID=isi-key-id-b2-kamu
B2_APPLICATION_KEY=isi-application-key-b2-kamu
B2_BUCKET_FOTO=gempaflores-foto
B2_BUCKET_VIDEO=gempaflores-video

# URL Worker yang sudah di-deploy (Bagian B di PANDUAN-B2.md)
WORKER_BASE_URL=https://gempaflores-storage.namaakunmu.workers.dev
